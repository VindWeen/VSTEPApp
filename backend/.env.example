# Server
PORT=5000
NODE_ENV=development

# ──────────────────────────────────────────────
# MongoDB Atlas
# ──────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vstep_db?retryWrites=true&w=majority

# ──────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ──────────────────────────────────────────────
# Groq AI – Writing & Speaking scoring (thay thế Gemini)
# Lấy từ: https://console.groq.com → API Keys → Create API Key
# Free tier: 14400 requests/ngày – đủ dùng cho dev
# ──────────────────────────────────────────────
GROQ_API_KEY=AIzaSy_your_groq_api_key_here

# ──────────────────────────────────────────────
# Cloudinary – Lưu audio file Speaking
# ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ──────────────────────────────────────────────
# Google Cloud Speech-to-Text
# ──────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# ──────────────────────────────────────────────
# DEV ONLY: Mock STT (true = dùng transcript giả, không cần Google credentials)
# Đặt false khi muốn test Speaking thật sự
# ──────────────────────────────────────────────
MOCK_STT=true

# ──────────────────────────────────────────────
# DEV ONLY: Mock AI (true = dùng band score giả, không cần Groq API)
# Đặt false khi có GROQ_API_KEY hoạt động
# ──────────────────────────────────────────────
MOCK_AI=true
